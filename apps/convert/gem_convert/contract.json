{
  "options": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pageRange": {
        "type": "string",
        "maxLength": 100,
        "pattern": "^\\d+(-\\d+)?(,\\d+(-\\d+)?)*$"
      },
      "strategy": {
        "type": "string",
        "enum": [
          "rasterize",
          "text"
        ]
      }
    },
    "additionalProperties": false
  },
  "reply": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "markdown": {
        "type": "string"
      },
      "pages": {
        "maxItems": 1000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "page": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "markdown": {
              "type": "string"
            }
          },
          "required": [
            "page",
            "markdown"
          ],
          "additionalProperties": false
        }
      },
      "outline": {
        "maxItems": 5000,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 500
            },
            "level": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "page": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "title",
            "level",
            "page"
          ],
          "additionalProperties": false
        }
      },
      "pageCount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "pagesConverted": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "figures": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "strategy": {
        "type": "string",
        "enum": [
          "rasterize",
          "text"
        ]
      },
      "converter": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40
          },
          "version": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": [
          "name",
          "version"
        ],
        "additionalProperties": false
      },
      "seconds": {
        "type": "number",
        "minimum": 0
      }
    },
    "required": [
      "markdown",
      "pages",
      "outline",
      "pageCount",
      "pagesConverted",
      "figures",
      "strategy",
      "converter",
      "seconds"
    ],
    "additionalProperties": false
  },
  "health": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "ok": {
        "type": "boolean",
        "const": true
      },
      "engine": {
        "type": "string",
        "enum": [
          "marker",
          "stub"
        ]
      },
      "engineVersion": {
        "type": "string",
        "maxLength": 40
      },
      "models": {
        "type": "string",
        "enum": [
          "loading",
          "ready",
          "failed"
        ]
      },
      "busy": {
        "type": "boolean"
      },
      "queued": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "conversions": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "workerStarts": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "limits": {
        "type": "object",
        "properties": {
          "maxBytes": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "maxPages": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "baseSeconds": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "secondsPerPage": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "maxBytes",
          "maxPages",
          "baseSeconds",
          "secondsPerPage"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "ok",
      "engine",
      "engineVersion",
      "models",
      "busy",
      "queued",
      "conversions",
      "workerStarts",
      "limits"
    ],
    "additionalProperties": false
  },
  "error": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "enum": [
          "bad_request",
          "too_large",
          "not_pdf",
          "too_many_pages",
          "bad_pdf",
          "bad_range",
          "empty",
          "timeout",
          "failed",
          "busy"
        ]
      },
      "message": {
        "type": "string",
        "maxLength": 500
      }
    },
    "required": [
      "code",
      "message"
    ],
    "additionalProperties": false
  }
}
