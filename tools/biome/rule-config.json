{
  "$comment": "Single source for no-literal-ui-string (SPEC §11.6). build-rule.ts generates no-literal-ui-string.grit and the biome.json plugin entry from this file. Change only through code review.",
  "message": "User-facing text must come from the i18n catalog: use t('…') (see SPEC §1.3).",
  "includes": ["apps/web/src/**/*.tsx", "apps/web/src/**/*.ts"],
  "excludes": ["**/*.test.tsx", "**/*.spec.tsx", "**/*.stories.tsx", "apps/web/src/i18n/**", "apps/web/src/dev/**"],
  "userVisibleAttributes": [
    "aria-label",
    "aria-description",
    "aria-valuetext",
    "aria-roledescription",
    "alt",
    "title",
    "placeholder",
    "label",
    "description",
    "helperText",
    "errorMessage",
    "tooltip",
    "emptyText",
    "confirmText",
    "cancelText"
  ],
  "neverFlaggedAttributes": [
    "className",
    "id",
    "key",
    "href",
    "src",
    "type",
    "role",
    "name",
    "htmlFor",
    "data-*",
    "aria-labelledby",
    "aria-describedby",
    "aria-controls",
    "data-testid",
    "form",
    "method",
    "rel",
    "target",
    "lang",
    "dir",
    "autoComplete",
    "inputMode"
  ],
  "messageFunctions": [
    "notify",
    "toast",
    "confirmDialog",
    "announce",
    "window.alert",
    "window.confirm",
    "window.prompt"
  ],
  "translationFunctions": ["t", "i18n.t"],
  "translationProps": ["i18nKey"],
  "properNouns": ["gem-proctor", "KaTeX", "Markdown", "LaTeX", "JSON", "CSV"]
}
