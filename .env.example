# gem-proctor environment (copy to .env; .env is never committed).
# Validated at startup by a Zod schema in apps/api (P0.md §5). Unknown or missing required keys fail fast.

NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
# API_HOST=0.0.0.0                       # optional; listen address
# TRUST_PROXY=false                      # optional; true only behind your own reverse proxy (X-Forwarded-For)
# WEB_DIST=apps/web/dist                 # optional; serve the built web app from the API (Compose sets it)

# ── Postgres (docker/compose.yaml) ─────────────────────────────────
POSTGRES_DB=gem_proctor
POSTGRES_PASSWORD=change-me              # superuser, used only by the init script
GEM_OWNER_PASSWORD=change-me             # owns schema, runs migrations (P0.md §4)
GEM_APP_PASSWORD=change-me               # runtime user; INSERT/SELECT only on audit_log
DATABASE_URL_OWNER=postgres://gem_owner:change-me@localhost:5432/gem_proctor
DATABASE_URL=postgres://gem_app:change-me@localhost:5432/gem_proctor
# POSTGRES_PORT=5432                     # optional; host port Compose publishes postgres on (127.0.0.1 only)
# MIGRATE_ON_START=true                  # optional; the API applies migrations as gem_owner on start

# ── Auth (SPEC §5.3) ───────────────────────────────────────────────
SESSION_SECRET=                          # 32+ random bytes, base64
ADMIN_EMAIL=                             # optional first-admin seed (SPEC §5.1); else first registration is admin
ADMIN_PASSWORD=
# AUTH_RATE_LIMIT_MAX=20                 # optional; login/register attempts per IP per window
# AUTH_RATE_LIMIT_WINDOW_MS=60000        # optional

# ── Secrets at rest (SPEC §3B.2; unused until P1.5) ────────────────
ENDPOINT_SECRET_KEY=                     # 32 random bytes, base64; encrypts endpoint API keys

# ── Verify worker (SPEC §3A.3.1; skeleton in P0) ───────────────────
# Unix socket in a shared volume: the verify container has no network (SPEC §3A.3.1).
VERIFY_SOCKET=/run/verify/verify.sock

# ── Dev LLM endpoint seed (dev only; unused until P1.5) ────────────
# In production, endpoints are created by an admin in the UI and stored in Postgres (SPEC §3B.2).
# In development, a seed script creates this endpoint and assigns it to roles if it doesn't exist.
LLM_DEV_LABEL=
LLM_DEV_PROVIDER=openai-compatible
LLM_DEV_SERVER=                          # ollama | vllm | llama.cpp | other
LLM_DEV_BASE_URL=                        # OpenAI-compatible base, ending in /v1
LLM_DEV_API_KEY=                         # blank for local servers without auth
LLM_DEV_MODEL=
LLM_DEV_CONTEXT=                         # tokens the server was launched with
LLM_DEV_STRUCTURED_MODE=native_schema    # native_schema | prompt_only (SPEC §3B.3)
LLM_DEV_CONCURRENCY=1
LLM_DEV_TIMEOUT_MS=120000
LLM_DEV_ROLES=authoring.objectives,authoring.generate,authoring.judge,verify.solve,analysis

# Embeddings (SPEC §3C; required from P2). Dimension fixes the pgvector column size.
LLM_DEV_EMBED_BASE_URL=
LLM_DEV_EMBED_MODEL=
LLM_DEV_EMBED_DIM=
# Longest input embedded without truncation (Ollama default: 2048, whatever the model card says; SPEC §3B.2).
LLM_DEV_EMBED_MAX_INPUT_TOKENS=
LLM_DEV_EMBED_QUERY_PREFIX=
LLM_DEV_EMBED_DOCUMENT_PREFIX=
# Reference model: embeddinggemma-2:270m, dim 768, prefixes "task: search result | query: " / "title: none | text: " (SPEC §3C.2).
